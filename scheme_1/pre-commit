#!/bin/sh

# ==========================================
# 配置区域
# ==========================================
REPORT_DIR=".git/reviews"
REPORT_FILE="$REPORT_DIR/claude-review-$(date +%Y%m%d-%H%M%S).md"
mkdir -p "$REPORT_DIR"

# 🚫 定义不需要审查的文件扩展名或文件名 (空格分隔)
EXCLUDE_PATTERNS=".gitignore .gitattributes .env .env.local package-lock.json yarn.lock composer.lock .DS_Store *.png *.jpg *.jpeg *.gif *.svg *.ico *.woff *.woff2 *.ttf *.eot"

# 📱 【新增】通知推送配置
# 飞书格式: user:openId (私聊用户)
# 请替换为你实际的飞书目标 ID：9897157c
FEISHU_TARGET="user:" 
ENABLE_FEISHU_NOTIFY=false # 设为 false 可临时关闭推送

# ==========================================
# 1. 获取并过滤变更文件
# ==========================================
echo "🔍 正在分析暂存区文件..."

ALL_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$ALL_FILES" ]; then
    exit 0
fi

FILES_TO_REVIEW=""
for FILE in $ALL_FILES; do
    SKIP=false
    
    for PATTERN in $EXCLUDE_PATTERNS; do
        # 精确匹配文件名
        if [ "$(basename "$FILE")" = "$PATTERN" ]; then
            SKIP=true
            break
        fi
        # 匹配后缀 (支持通配符逻辑简化版)
        case "$FILE" in
            *"$PATTERN")
                SKIP=true
                break
                ;;
        esac
    done

    if [ "$SKIP" = false ]; then
        FILES_TO_REVIEW="$FILES_TO_REVIEW $FILE"
    else
        echo "   ⏭️  跳过审查: $FILE"
    fi
done

if [ -z "$(echo $FILES_TO_REVIEW | xargs)" ]; then
    echo "✅ 本次提交仅包含配置或资源文件，跳过代码审查。"
    exit 0
fi

echo "   📝 待审查文件:$FILES_TO_REVIEW"

# ==========================================
# 2. 生成针对特定文件的 Diff
# ==========================================
DIFF_CONTENT=$(git diff --cached -- $FILES_TO_REVIEW)

if [ -z "$DIFF_CONTENT" ]; then
    echo "⚠️ 过滤后无有效代码变更，跳过审查。"
    exit 0
fi

# ==========================================
# 3. 准备审查规范
# ==========================================
GUIDELINES_CONTENT=""
if [ -f "REVIEW_GUIDELINES.md" ]; then
    GUIDELINES_CONTENT=$(cat "REVIEW_GUIDELINES.md")
elif [ -f "docs/REVIEW_GUIDELINES.md" ]; then
    GUIDELINES_CONTENT=$(cat "docs/REVIEW_GUIDELINES.md")
fi

if [ -z "$GUIDELINES_CONTENT" ]; then
    GUIDELINES_CONTENT="无特定规范，请依据通用最佳实践审查。"
fi

# ==========================================
# 4. 执行 Claude 审查
# ==========================================
echo "🤖 正在调用 Claude 进行代码审查..."

PROMPT="你是一名严格的代码审查专家。请根据以下规范审查代码变更。

【审查规范】:
$GUIDELINES_CONTENT

【代码变更】:
$DIFF_CONTENT

【输出要求】:
1. 如果代码存在**严重错误**、**安全漏洞**或**违反核心规范**，必须在第一行明确输出 '❌ 审查不通过' 或 'BLOCKING'。
2. 如果只是小建议或风格问题，输出 '⚠️ 审查通过但有建议'。
3. 如果完美，输出 '✅ 审查通过'。
4. 随后列出具体的问题点和修改建议。
5. 请用 Markdown 格式输出。"

# 执行并捕获输出
claude -p "$PROMPT" > "$REPORT_FILE" 2>&1
CLAUDE_EXIT_CODE=$?

if [ $CLAUDE_EXIT_CODE -ne 0 ] || [ ! -s "$REPORT_FILE" ]; then
    echo "❌ 错误：Claude 执行失败或未生成报告。"
    # 即使 Claude 失败，也不建议阻断提交（除非你非常严格），这里选择警告并放行
    echo "⚠️ 审查服务不可用，已记录日志，允许提交。"
    exit 0 
fi

# ==========================================
# 5. 智能分析结果 (拦截逻辑)
# ==========================================
echo "🔍 正在分析审查报告..."

STATUS="PASS"
IS_BLOCKING=false

# 检测严重错误关键词
if grep -qiE "❌|审查不通过|BLOCKING|必须修复|Cannot accept" "$REPORT_FILE"; then
    STATUS="FAIL"
    IS_BLOCKING=true
# 检测警告关键词
elif grep -qiE "⚠️|建议|Warning|Minor" "$REPORT_FILE"; then
    STATUS="WARN"
fi

# ==========================================
# 6. 输出摘要并决定去留
# ==========================================
echo ""
echo "=========================================="
echo "📄 审查报告摘要:"
echo "=========================================="
head -n 20 "$REPORT_FILE"
if [ $(wc -l < "$REPORT_FILE") -gt 20 ]; then
    echo "... (完整报告已保存至: $REPORT_FILE)"
fi
echo "=========================================="
echo ""

# ==========================================
# 7. 【新增】异步推送到飞书
# ==========================================
# 只要生成了报告，且开启了通知，就推送（无论通过与否，让开发者知晓）
# 如果是 FAIL 或 WARN，推送优先级更高
if [ "$ENABLE_FEISHU_NOTIFY" = true ] && [ -s "$REPORT_FILE" ]; then
    (
        # 提取前 5 行作为摘要，处理特殊字符防止命令注入
        SUMMARY=$(head -n 5 "$REPORT_FILE" | sed 's/"/\\"/g' | tr '\n' ' ' | cut -c 1-200)
        PROJECT_NAME=$(basename $(pwd))
        
        # 根据状态构造不同前缀
        if [ "$STATUS" = "FAIL" ]; then
            PREFIX="🛑 **提交阻断**"
        elif [ "$STATUS" = "WARN" ]; then
            PREFIX="⚠️ **提交通过但有建议**"
        else
            PREFIX="✅ **审查通过**"
        fi

        MSG="${PREFIX}
📂 项目：${PROJECT_NAME}
📝 摘要：${SUMMARY}...

🔗 完整报告请查看仓库内：${REPORT_FILE}"

        # 🚀 后台静默推送 (nohup + &)
        # 使用飞书直接发送
        if command -v openclaw >/dev/null 2>&1; then
            nohup openclaw message send \
                --channel feishu \
                --target "${FEISHU_TARGET}" \
                --message "${MSG}" \
                >/dev/null 2>&1 &
            echo "已发送飞书通知"
        else
            # 备用方案：使用 Python 脚本
            if command -v python3 >/dev/null 2>&1; then
                PYTHON_CMD="python3"
            elif command -v python >/dev/null 2>&1; then
                PYTHON_CMD="python"
            else
                echo "警告: Python 未找到，跳过飞书通知"
                return 0
            fi
            
            SCRIPT_PATH="C:/Users/Administrator/.openclaw/workspace/notify_multi.py"
            if [ -f "$SCRIPT_PATH" ]; then
                nohup "$PYTHON_CMD" "$SCRIPT_PATH" \
                    "feishu" \
                    "${FEISHU_TARGET}" \
                    "${MSG}" \
                    >/dev/null 2>&1 &
                echo "已通过脚本发送飞书通知"
            else
                echo "警告: 通知脚本未找到: $SCRIPT_PATH"
            fi
        fi
            
    ) &
fi

# ==========================================
# 【新增功能】辅助函数：尝试在编辑器中打开文件
# ==========================================
open_in_editor() {
    local FILE_PATH="$1"
    local EDITOR_CMD=""

    # 检测常见编辑器命令
    if command -v code >/dev/null 2>&1; then
        EDITOR_CMD="code"
    elif command -v cursor >/dev/null 2>&1; then
        EDITOR_CMD="cursor"
    elif command -v webstorm >/dev/null 2>&1; then
        EDITOR_CMD="webstorm"
    elif command -v phpstorm >/dev/null 2>&1; then
        EDITOR_CMD="phpstorm"
    elif command -v subl >/dev/null 2>&1; then
        EDITOR_CMD="subl"
    # Windows 兼容性补充
    elif command -v where >/dev/null 2>&1 && where code >/dev/null 2>&1; then
        EDITOR_CMD="code"
    fi

    if [ -n "$EDITOR_CMD" ]; then
        echo "🚀 正在使用 [$EDITOR_CMD] 打开审查报告..."
        # 使用 & 后台运行，避免阻塞 git commit 流程
        "$EDITOR_CMD" "$FILE_PATH" &
    else
        echo "💡 未在 PATH 中找到常用编辑器 (code/cursor/webstorm 等)，跳过自动打开。"
        echo "   请手动打开: $FILE_PATH"
    fi
}

# ==========================================
# 8. 最终决策
# ==========================================
# 🌟 核心逻辑：如果有报告文件，立即尝试打开
if [ -s "$REPORT_FILE" ]; then
    open_in_editor "$REPORT_FILE"
fi

if [ "$IS_BLOCKING" = true ]; then
    echo "🛑 【提交被阻断】"
    echo "原因：发现严重问题或违反核心规范。"
    echo "操作：请修复后重新提交。"
    echo "完整报告: $REPORT_FILE"
    echo "💡 推送通知已发送至飞书。"
    exit 1
else
    if [ "$STATUS" = "WARN" ]; then
        echo "⚠️ 【提交允许，但有建议】"
    else
        echo "✅ 【审查通过】"
    fi
    echo "💡 审查报告已发送至飞书。"
    exit 0
fi